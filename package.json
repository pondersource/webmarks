    "ember-service-worker-asset-cache": "^0.6.4",
    "ember-service-worker-index": "^0.7.0",
    "ember-source": "~3.28.12",
    "es6-promise": "^4.2.8",
    "eslint": "^6.8.0",
    "eslint-plugin-ember": "^7.7.1",
    "eslint-plugin-node": "11.x",
    "loader.js": "^4.7.0",
    "qunit-dom": "^0.9.2",
    "sass": "^1.107.1",
    "webpack": "^5.112.2"
  },
  "engines": {
    "node": "^22.12.0"
  },
  "ember": {
    "edition": "octane"
  },
  "dependencies": {
    "moment": "^2.31.0",
